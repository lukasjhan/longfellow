# --- upstream is now a git submodule (see .gitmodules); pinned, not vendored ---

# --- C++ build outputs ---
/build/
*.log

# --- generated clang toolchain wrappers (machine-specific paths) ---
/.toolchain/

# --- compiled CLI binary & objects ---
playground/native/longfellow_cli
playground/native/jwt_cli
playground/native/sdjwt_eval
playground/native/sdjwt_zk
playground/native/sdjwt_full
playground/native/sha_bench
playground/native/sdjwt_sig
playground/native/sdjwt_hash
playground/native/sdjwt_split
playground/native/sdjwt_nullifier
playground/native/sdjwt_null_split
playground/native/sdjwt_null_blind
playground/native/mdoc_null_split
playground/native/mdoc_null_blind
playground/native/sdjwt_revoc_split
playground/native/mdoc_revoc_split
playground/native/*.o
playground/native/err.log

# --- node ---
node_modules/
node_modules
playground/node_modules
npm-debug.log*
pnpm-debug.log*

# --- generated playground artifacts (proofs, circuits, etc.) ---
playground/artifacts/*
!playground/artifacts/.gitkeep
playground/artifacts-multi/
playground/artifacts-jwt/

# --- cached circuits: keep the manifest, ignore the big .bin blobs ---
playground/circuits/*.bin
playground/circuits-cache/

# --- generated mdoc fixtures (regenerable via gen:mdoc / gen:mdoc-blind; contain
#     a device key, and mdoc-holder-secret.txt is the holder's private secret) ---
playground/fixtures/mdoc*

# --- generated blind-nullifier fixtures (regenerable via gen:sdjwt-blind;
#     holder-secret.txt is the holder's private secret/blind, never committed) ---
playground/fixtures/sdjwt-blind.txt
playground/fixtures/issuer-jwk-blind.json
playground/fixtures/holder-jwk-blind.json
playground/fixtures/parsed-blind.json
playground/fixtures/holder-secret.txt

# --- third-party papers (links in references/README.md) ---
references/*.pdf

# --- editor / OS / tooling ---
.claude/
.DS_Store
*.swp
