{
  "name": "longfellow-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js playground for google/longfellow-zk: issue (example) -> present (ZK prove) -> verify, driven via a thin C++ CLI subprocess.",
  "scripts": {
    "build:native": "bash native/build.sh",
    "circuits": "node src/prebuild-circuits.js",
    "demo": "node src/demo.js",
    "demo:multi": "node src/demo-multi.js",
    "demo:jwt": "node src/demo-jwt.js",
    "decode:sdjwt": "node src/decode-sdjwt.js",
    "gen:sdjwt": "node tools/gen-sdjwt.mjs",
    "gen:mdoc": "node tools/gen-mdoc.mjs",
    "gen:mdoc-blind": "node tools/gen-mdoc-blind.mjs",
    "gen:sdjwt-big": "BIG=1 node tools/gen-sdjwt.mjs",
    "gen:sdjwt-blind": "node tools/gen-sdjwt-blind.mjs",
    "eval:sdjwt": "native/sdjwt_eval fixtures/sdjwt.txt",
    "demo:sdjwt-zk": "node src/demo-sdjwt-zk.js",
    "demo:sdjwt-split": "node src/demo-sdjwt-split.js",
    "demo:nullifier": "node src/demo-nullifier.js",
    "demo:nullifier-blind": "node src/demo-nullifier-blind.js",
    "demo:mdoc-nullifier": "node src/demo-mdoc-nullifier.js",
    "demo:mdoc-nullifier-blind": "node src/demo-mdoc-nullifier-blind.js",
    "issue": "node src/playground.js issue",
    "present": "node src/playground.js present",
    "verify": "node src/playground.js verify",
    "decode": "node src/decode-mdoc.js"
  }
}
